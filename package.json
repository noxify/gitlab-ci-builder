{
  "name": "@noxify/gitlab-ci-builder",
  "version": "1.5.0",
  "description": "Build GitLab CI/CD pipelines programmatically with TypeScript. Fluent API for creating jobs, templates, and workflows. Import/export YAML, visualize with Mermaid diagrams, and resolve extends chains automatically.",
  "keywords": [
    "gitlab",
    "gitlab-ci",
    "ci-cd",
    "continuous-integration",
    "continuous-deployment",
    "pipeline",
    "yaml",
    "builder",
    "typescript",
    "devops",
    "automation",
    "infrastructure-as-code",
    "gitops",
    "configuration",
    "configuration-management",
    "visualization",
    "mermaid",
    "code-generation",
    "fluent-api",
    "extends-resolution"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/noxiy/gitlab-ci-builder.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./src/index.ts"
    }
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "gitlab-ci-builder": "./dist/cli/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "ci:publish": "pnpm build && pnpm publish -r --access public --publish-branch main && pnpm changeset tag",
    "ci:version": "pnpm changeset version && pnpm install --no-frozen-lockfile && git add .",
    "cli:dev": "tsx src/cli/index.ts",
    "cs": "changeset",
    "dev": "tsdown --watch",
    "format": "prettier --check . --ignore-path ./.gitignore --ignore-path ./.prettierignore",
    "format:fix": "prettier --write . --ignore-path ./.gitignore --ignore-path ./.prettierignore",
    "generate:types": "tsx src/generate-types.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run",
    "test:coverage": "vitest --coverage",
    "test:e2e": "pnpm build && vitest --run --project e2e",
    "test:integration": "vitest --run --project integration",
    "test:ui": "vitest --ui",
    "test:unit": "vitest --run --project unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "./prettier.config.mjs",
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "climt": "^0.2.0",
    "commander": "^14.0.2",
    "deepmerge": "4.3.1",
    "js-yaml": "4.1.1",
    "oo-ascii-tree": "^1.124.0",
    "read-pkg": "^10.0.0",
    "tinyglobby": "0.2.15",
    "typescript": "5.9.3",
    "zod": "4.3.4"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@eslint/compat": "2.0.0",
    "@eslint/js": "9.39.2",
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.4",
    "@vitest/coverage-v8": "4.0.16",
    "dedent": "1.7.1",
    "eslint": "9.39.2",
    "eslint-config-turbo": "2.7.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-package-json": "0.87.1",
    "json-schema-to-typescript": "15.0.4",
    "jsonc-eslint-parser": "2.4.2",
    "memfs": "4.51.1",
    "msw": "^2.12.7",
    "node-pty": "1.1.0",
    "prettier": "3.7.4",
    "tsdown": "0.18.4",
    "tsx": "4.21.0",
    "tuistory": "0.0.6",
    "typescript-eslint": "8.51.0",
    "vitest": "4.0.16"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
